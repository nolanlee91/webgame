{
  "name": "webgame-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Webgame Portal — bản chơi thử (trang chủ + game HTML5) phục vụ tĩnh để test online",
  "scripts": {
    "start": "node server.js",
    "dev:ma-soi": "node games-server/ma-soi/dev.js",
    "test:ma-soi": "node --test --test-concurrency=1 games-server/ma-soi/test/*.test.mjs",
    "test:ma-soi:e2e": "node games-server/ma-soi/test/browser-e2e.mjs",
    "dev:ai-la-noi-gian": "node games-server/ai-la-noi-gian/dev.js",
    "test:ai-la-noi-gian": "node --test --test-concurrency=1 games-server/ai-la-noi-gian/test/*.test.mjs",
    "test:ai-la-noi-gian:e2e": "node games-server/ai-la-noi-gian/test/browser-e2e.mjs",
    "dev:dat-bom": "node games-server/dat-bom/dev.js",
    "test:dat-bom": "node --test --test-concurrency=1 games-server/dat-bom/test/*.test.mjs",
    "test:dat-bom:e2e": "node games-server/dat-bom/test/browser-e2e.mjs",
    "test:noi-tu": "node --test --test-concurrency=1 --test-timeout=20000 games-server/noi-tu/test/*.test.mjs",
    "test:ws": "node --test games-server/ws-coalesce.test.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
